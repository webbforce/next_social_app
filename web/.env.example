# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (sb_publishable_...) or legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site origin. On Vercel this is the production URL; locally it can stay localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret (sb_secret_...) or legacy service_role key. Server only; never expose or commit.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel Cron sends this as Authorization: Bearer … . Optional locally.
CRON_SECRET=
# Real host SMS: Authentication → Providers → Phone in the hosted Supabase project (Twilio).
# Until that is on, Auth test phones +31600000001–003 / code 123456 still work.
# New hosts save an account with Apple, Google, or email. Enable those providers in
# Authentication → Providers, and set the redirect URL to {NEXT_PUBLIC_SITE_URL}/auth/callback.
# Hosts who enter this key at /reports become admins and can review reports.
REPORTS_SECRET=
